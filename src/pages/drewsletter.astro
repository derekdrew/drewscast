---
export const prerender = false;

import { getNewsletterPosts } from "../lib/substack.js";

let posts = [];
let feedAvailable = true;
try {
  posts = await getNewsletterPosts();
} catch {
  feedAvailable = false;
}

const siteUrl = "https://www.drewscast.com";
const pageTitle = "The Drewsletter | Drewscast";
const pageDescription = "Read Derek Drew’s written companion to Drewscast: the stories worth knowing, why they matter, and what others may be missing.";
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E7WVB5CZWT"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E7WVB5CZWT');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#07182e" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={siteUrl + "/drewsletter"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Drewscast" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={siteUrl + "/drewsletter"} />
    <meta name="twitter:card" content="summary" />
    <style>
      :root { --background: #f5f3ee; --text: #111; --muted: #666; --line: #d8d5ce; --accent: #d7ff38; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--background); color: var(--text); font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      a { color: inherit; text-decoration: none; }
      .container { width: min(1000px, calc(100% - 40px)); margin: 0 auto; }
      header { border-bottom: 1px solid var(--line); }
      nav { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
      .logo { font-size: 1.15rem; font-weight: 900; letter-spacing: -.06em; }
      .nav-links { display: flex; gap: 22px; font-size: .95rem; }
      main { padding: 76px 0 90px; }
      .eyebrow { margin: 0 0 18px; font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
      h1 { max-width: 800px; margin: 0; font-size: clamp(3rem, 8vw, 5.8rem); line-height: .96; letter-spacing: -.075em; }
      .intro { max-width: 650px; margin: 24px 0 30px; color: #444; font-size: 1.15rem; line-height: 1.55; }
      .button { display: inline-flex; align-items: center; justify-content: center; padding: 13px 20px; border: 1px solid var(--text); border-radius: 999px; background: var(--text); color: white; font-weight: 750; }
      .post-list { display: grid; gap: 14px; margin-top: 40px; }
      .post { padding: 25px 27px; border: 1px solid var(--line); border-radius: 16px; background: white; }
      .date { color: var(--muted); font-size: .75rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
      h2 { margin: 10px 0; font-size: clamp(1.4rem, 3vw, 2rem); line-height: 1.1; letter-spacing: -.04em; }
      .description { margin: 0; color: #555; line-height: 1.55; }
      .read-more { display: inline-block; margin-top: 15px; font-weight: 800; }
      .notice { margin-top: 28px; color: var(--muted); line-height: 1.6; }
      footer { padding: 32px 0; border-top: 1px solid var(--line); color: var(--muted); }
      @media (max-width: 520px) { .container { width: calc(100% - 28px); } nav { min-height: 62px; } .nav-links { gap: 14px; } main { padding-top: 54px; } .post { padding: 21px; } }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <nav aria-label="Main navigation">
          <a href="/" class="logo">DREWSCAST</a>
          <div class="nav-links"><a href="/">Home</a><a href="/episodes">Episodes</a><a href="/drewsletter">Drewsletter</a></div>
        </nav>
      </div>
    </header>
    <main class="container">
      <p class="eyebrow">The written companion</p>
      <h1>The Drewsletter.</h1>
      <p class="intro">The stories worth knowing, delivered in writing. Derek Drew connects the news to the bigger picture, without making you scroll all morning.</p>
      <a class="button" href="https://thedrewsletter.substack.com/" target="_blank" rel="noopener noreferrer">Subscribe on Substack</a>
      {posts.length ? (
        <section class="post-list" aria-label="Recent Drewsletter articles">
          {posts.map((post) => (
            <article class="post">
              {post.pubDate && <div class="date">{new Date(post.pubDate).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })}</div>}
              <h2><a href={post.link} target="_blank" rel="noopener noreferrer">{post.title}</a></h2>
              {post.description && <p class="description">{post.description.slice(0, 300)}{post.description.length > 300 ? "…" : ""}</p>}
              <a class="read-more" href={post.link} target="_blank" rel="noopener noreferrer">Read on Substack →</a>
            </article>
          ))}
        </section>
      ) : (
        <p class="notice">{feedAvailable ? "New articles will appear here as they are published." : "The article feed could not be loaded right now. You can browse the full archive on Substack."} <a href="https://thedrewsletter.substack.com/" target="_blank" rel="noopener noreferrer"><strong>Browse the Drewsletter archive →</strong></a></p>
      )}
    </main>
    <footer><div class="container">© 2026 Drewscast · <a href="/">Home</a></div></footer>
  </body>
</html>
