---
export const prerender = false;

import { getEpisodes } from "../../lib/rss.js";

const { slug } = Astro.params;
const episodes = await getEpisodes();
const episode = episodes.find((item) => item.slug === slug);
const siteUrl = "https://drewscast.com";
const canonicalUrl = siteUrl + Astro.url.pathname;
const pageTitle = episode ? episode.title + " | Drewscast" : "Episode Not Found | Drewscast";
const pageDescription = episode?.description
  ? episode.description.slice(0, 155)
  : "Explore Drewscast episodes with Derek Drew.";
const episodeSchema = episode
  ? {
      "@context": "https://schema.org",
      "@type": "PodcastEpisode",
      name: episode.title,
      description: episode.description,
      datePublished: episode.pubDate ? new Date(episode.pubDate).toISOString() : undefined,
      url: canonicalUrl,
      partOfSeries: {
        "@type": "PodcastSeries",
        name: "Drewscast",
        url: siteUrl,
      },
      associatedMedia: episode.audioUrl
        ? { "@type": "MediaObject", contentUrl: episode.audioUrl, encodingFormat: "audio/mpeg" }
        : undefined,
    }
  : null;
const schemaJson = episodeSchema ? JSON.stringify(episodeSchema).replace(/</g, "\\u003c") : "";
if (!episode) Astro.response.status = 404;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E7WVB5CZWT"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E7WVB5CZWT');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#07182e" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Drewscast" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    {episodeSchema && <script type="application/ld+json" set:html={schemaJson} />}
    <style>
      :root { --background: #f5f3ee; --text: #111; --muted: #666; --line: #d8d5ce; --accent: #d7ff38; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--background); color: var(--text); font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      a { color: inherit; text-decoration: none; }
      .container { width: min(900px, calc(100% - 40px)); margin: 0 auto; }
      header { border-bottom: 1px solid var(--line); }
      nav { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
      .logo { font-size: 1.15rem; font-weight: 900; letter-spacing: -.06em; }
      .nav-links { display: flex; gap: 22px; font-size: .95rem; }
      main { padding: 76px 0 90px; }
      .eyebrow { margin: 0 0 20px; color: var(--muted); font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
      h1 { margin: 0; font-size: clamp(2.8rem, 7vw, 5.5rem); line-height: .98; letter-spacing: -.07em; }
      .description { margin: 28px 0; color: #444; font-size: 1.15rem; line-height: 1.7; white-space: pre-line; }
      .buttons { display: flex; flex-wrap: wrap; gap: 12px; margin: 30px 0; }
      .button { display: inline-flex; align-items: center; justify-content: center; padding: 13px 19px; border: 1px solid var(--text); border-radius: 999px; background: var(--text); color: white; font-weight: 750; }
      .button.secondary { background: transparent; color: var(--text); }
      .player { width: 100%; margin: 28px 0; }
      .back { display: inline-block; margin-top: 25px; font-weight: 800; }
      footer { padding: 32px 0; border-top: 1px solid var(--line); color: var(--muted); }
      @media (max-width: 520px) { .container { width: calc(100% - 28px); } nav { min-height: 62px; } .nav-links { gap: 14px; } main { padding-top: 52px; } }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <nav aria-label="Main navigation">
          <a href="/" class="logo">DREWSCAST</a>
          <div class="nav-links"><a href="/">Home</a><a href="/episodes">Episodes</a><a href="/drewsletter">Drewsletter</a></div>
        </nav>
      </div>
    </header>
    <main class="container">
      {episode ? (
        <>
          <p class="eyebrow">
            {episode.pubDate && new Date(episode.pubDate).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })}
            {episode.duration ? " · " + episode.duration : ""}
          </p>
          <h1>{episode.title}</h1>
          {episode.description && <p class="description">{episode.description}</p>}
          {episode.audioUrl && <audio class="player" controls preload="none" src={episode.audioUrl}>Your browser does not support the audio player.</audio>}
          <div class="buttons">
            <a class="button" href="https://open.spotify.com/show/67py7BCCUDAomXOPEh9pXO" target="_blank" rel="noopener noreferrer">Listen on Spotify</a>
            <a class="button secondary" href="https://www.youtube.com/@drewscast" target="_blank" rel="noopener noreferrer">Watch on YouTube</a>
            {episode.link && <a class="button secondary" href={episode.link} target="_blank" rel="noopener noreferrer">Original episode page</a>}
          </div>
          <a class="back" href="/episodes">← Browse all episodes</a>
        </>
      ) : (
        <>
          <p class="eyebrow">404 · Not found</p>
          <h1>That episode isn’t here.</h1>
          <p class="description">It may have moved or the address may be incorrect. Browse the episode archive to find it.</p>
          <a class="button" href="/episodes">Browse all episodes</a>
        </>
      )}
    </main>
    <footer><div class="container">© 2026 Drewscast · <a href="/">Home</a></div></footer>
  </body>
</html>
