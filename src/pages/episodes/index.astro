---
export const prerender = false;

import { getEpisodes } from "../../lib/rss.js";

const episodes = await getEpisodes();
const siteUrl = "https://drewscast.com";
const pageTitle = "Drewscast Episodes | Markets, Business, AI & Tech";
const pageDescription = "Explore Drewscast episodes with Derek Drew. Clear, concise context on markets, business, technology, and the stories shaping the world.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={siteUrl + "/episodes"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Drewscast" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={siteUrl + "/episodes"} />
    <meta name="twitter:card" content="summary" />
    <style>
      :root { --background: #f5f3ee; --text: #111; --muted: #666; --line: #d8d5ce; --accent: #d7ff38; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--background); color: var(--text); font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      a { color: inherit; text-decoration: none; }
      .container { width: min(1000px, calc(100% - 40px)); margin: 0 auto; }
      header { border-bottom: 1px solid var(--line); }
      nav { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
      .logo { font-size: 1.15rem; font-weight: 900; letter-spacing: -.06em; }
      .nav-links { display: flex; gap: 22px; font-size: .95rem; }
      main { padding: 76px 0 90px; }
      .eyebrow { margin: 0 0 18px; font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
      h1 { max-width: 800px; margin: 0; font-size: clamp(3rem, 8vw, 5.8rem); line-height: .96; letter-spacing: -.075em; }
      .intro { max-width: 650px; margin: 24px 0 36px; color: #444; font-size: 1.15rem; line-height: 1.55; }
      .search { width: 100%; max-width: 520px; padding: 15px 17px; border: 1px solid var(--line); border-radius: 12px; background: white; color: var(--text); font: inherit; }
      .count { margin: 24px 0 14px; color: var(--muted); font-size: .9rem; }
      .episode-list { display: grid; gap: 14px; }
      .episode[hidden] { display: none; }
      .episode { display: block; padding: 25px 27px; border: 1px solid var(--line); border-radius: 16px; background: white; transition: transform .15s ease, border-color .15s ease; }
      .episode:hover { transform: translateY(-2px); border-color: #888; }
      .date { color: var(--muted); font-size: .75rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
      h2 { margin: 10px 0; font-size: clamp(1.4rem, 3vw, 2rem); line-height: 1.1; letter-spacing: -.04em; }
      .description { margin: 0; color: #555; line-height: 1.55; }
      .read-more { display: inline-block; margin-top: 15px; font-weight: 800; }
      .empty { display: none; padding: 30px; color: var(--muted); }
      footer { padding: 32px 0; border-top: 1px solid var(--line); color: var(--muted); }
      @media (max-width: 520px) { .container { width: calc(100% - 28px); } nav { min-height: 62px; } .nav-links { gap: 14px; } main { padding-top: 54px; } .episode { padding: 21px; } }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <nav aria-label="Main navigation">
          <a href="/" class="logo">DREWSCAST</a>
          <div class="nav-links">
            <a href="/">Home</a>
            <a href="/episodes">Episodes</a>
            <a href="/drewsletter">Drewsletter</a>
          </div>
        </nav>
      </div>
    </header>
    <main class="container">
      <p class="eyebrow">The Drewscast archive</p>
      <h1>Every episode.<br />More context.</h1>
      <p class="intro">What’s happening. Why it matters. What everyone else is missing. Browse the episodes or search for a story you want to understand better.</p>
      <label for="episode-search" class="eyebrow">Search episodes</label>
      <input id="episode-search" class="search" type="search" placeholder="Try markets, a company, or a topic…" autocomplete="off" />
      <p class="count" id="episode-count" aria-live="polite">{episodes.length} {episodes.length === 1 ? "episode" : "episodes"}</p>
      <div class="episode-list" id="episode-list">
        {episodes.map((episode) => (
          <article class="episode" data-search={(episode.title + " " + episode.description).toLowerCase()}>
            <a href={"/episodes/" + episode.slug}>
              {episode.pubDate && <div class="date">{new Date(episode.pubDate).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })}</div>}
              <h2>{episode.title || "Drewscast episode"}</h2>
              {episode.description && <p class="description">{episode.description.slice(0, 260)}{episode.description.length > 260 ? "…" : ""}</p>}
              <span class="read-more">Episode details →</span>
            </a>
          </article>
        ))}
      </div>
      <p class="empty" id="no-results">No episodes match that search. Try another keyword.</p>
    </main>
    <footer><div class="container">© 2026 Drewscast · <a href="/">Home</a></div></footer>
    <script>
      const search = document.querySelector("#episode-search");
      const cards = [...document.querySelectorAll(".episode")];
      const count = document.querySelector("#episode-count");
      const empty = document.querySelector("#no-results");
      search?.addEventListener("input", () => {
        const query = search.value.trim().toLowerCase();
        let visible = 0;
        for (const card of cards) {
          const matches = card.dataset.search.includes(query);
          card.hidden = !matches;
          if (matches) visible++;
        }
        count.textContent = visible + (visible === 1 ? " episode" : " episodes");
        empty.style.display = visible ? "none" : "block";
      });
    </script>
  </body>
</html>
